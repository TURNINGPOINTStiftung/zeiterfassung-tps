rules_version = '2';

// Firebase Storage – TPS Zeiterfassung
// Live NUR in der Firebase-Konsole (Storage → Rules); diese Datei ist die versionierte Referenz.
//
// Storage-Regeln können die Realtime Database (allowed/admins) NICHT abfragen. Das Admin-Recht
// hängt daher am technischen Anmeldekonto des Administrators: admin@tps.intern
// (Schema <id>@tps.intern, siehe js/firebase.js).
//
// ACHTUNG: In Authentication ist „Enable create (sign-up)" an (die App legt Konten neuer
// Mitarbeiter clientseitig an). „Angemeldet" heißt daher NICHT „freigeschaltet" – deshalb:
//  • nur Konten nach App-Schema (@tps.intern),
//  • Backup-Dateien tragen die UID des Hochladenden im Namen → ein fremdes Konto kann das
//    echte Tages-Backup weder blockieren noch vortäuschen,
//  • CRM-Anhänge nur per Einzelabruf (get), kein Auflisten.
service firebase.storage {
  match /b/{bucket}/o {

    function appUser() { return request.auth != null
                           && request.auth.token.email is string
                           && request.auth.token.email.matches('^[a-z0-9._-]+@tps[.]intern$'); }
    function isAdmin() { return request.auth != null && request.auth.token.email == 'admin@tps.intern'; }

    // ── Automatische App-Backups (js/backup.js): backups/daily/<YYYY-MM-DD>_<uid>.json ──
    match /backups/daily/{name} {
      allow create: if appUser()
                    && name.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_' + request.auth.uid + '[.]json$')
                    && request.resource.size < 25 * 1024 * 1024
                    && request.resource.contentType == 'application/json';
      allow read, delete: if isAdmin();   // read = get + list
      allow update: if false;             // Backups sind unveränderlich
    }
    // ── Persönliche Monats-Schnappschüsse (js/user-backup.js, Phase 2) ──
    //    backups/user/<uid>/<YYYY-MM>_ze.json  bzw. _reports.json
    //    Jede Person darf NUR ihren EIGENEN Ordner schreiben/lesen/aufräumen (uid == eigene Auth-UID);
    //    der Admin darf alles lesen (siehe backups/{rest=**}).
    match /backups/user/{uid}/{name} {
      allow create, update:
        if appUser() && uid == request.auth.uid
        && name.matches('^[0-9]{4}-[0-9]{2}_(ze|reports)[.]json$')
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/json';
      allow read, delete: if isAdmin() || (appUser() && uid == request.auth.uid);   // read = get + list des eigenen Ordners
    }

    match /backups/{rest=**} {
      allow read: if isAdmin();           // Auflisten von backups/ für die Verwaltung
    }

    // ── CRM-Dateianhänge (js/crm/crm.js: crm-anlagen/<nodeId>/<zeit>_<name>) ──
    match /crm-anlagen/{nid}/{file} {
      allow get:    if appUser();
      allow create: if appUser() && request.resource.size < 15 * 1024 * 1024;
      allow delete: if appUser();
      allow update: if false;
    }
  }
}
