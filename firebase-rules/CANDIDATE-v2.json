{
  "rules": {
    "zeiterfassung": {
      ".read": "auth != null && root.child('zeiterfassung/allowed').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('zeiterfassung/admins').child(auth.uid).val() === true",

      "loginDir": {
        ".read": true,
        "$key": { ".validate": "!newData.exists() || $key.matches(/^[A-Za-z0-9._-]+$/)" }
      },

      "users": {
        "$i": {
          "id": { ".validate": "!newData.exists() || newData.val().matches(/^[A-Za-z0-9._-]+$/)" },
          "pw":              { ".write": "auth != null && (root.child('zeiterfassung/admins').child(auth.uid).val() === true || (root.child('zeiterfassung/allowed').child(auth.uid).val() === true && root.child('zeiterfassung/uidUser').child(auth.uid).val() === root.child('zeiterfassung/users').child($i).child('id').val()))" },
          "email":           { ".write": "auth != null && (root.child('zeiterfassung/admins').child(auth.uid).val() === true || (root.child('zeiterfassung/allowed').child(auth.uid).val() === true && root.child('zeiterfassung/uidUser').child(auth.uid).val() === root.child('zeiterfassung/users').child($i).child('id').val()))" },
          "city":            { ".write": "auth != null && (root.child('zeiterfassung/admins').child(auth.uid).val() === true || (root.child('zeiterfassung/allowed').child(auth.uid).val() === true && root.child('zeiterfassung/uidUser').child(auth.uid).val() === root.child('zeiterfassung/users').child($i).child('id').val()))" },
          "bundesland":      { ".write": "auth != null && (root.child('zeiterfassung/admins').child(auth.uid).val() === true || (root.child('zeiterfassung/allowed').child(auth.uid).val() === true && root.child('zeiterfassung/uidUser').child(auth.uid).val() === root.child('zeiterfassung/users').child($i).child('id').val()))" },
          "lecturePeriods":  { ".write": "auth != null && (root.child('zeiterfassung/admins').child(auth.uid).val() === true || (root.child('zeiterfassung/allowed').child(auth.uid).val() === true && root.child('zeiterfassung/uidUser').child(auth.uid).val() === root.child('zeiterfassung/users').child($i).child('id').val()))" },
          "lectureFreeDays": { ".write": "auth != null && (root.child('zeiterfassung/admins').child(auth.uid).val() === true || (root.child('zeiterfassung/allowed').child(auth.uid).val() === true && root.child('zeiterfassung/uidUser').child(auth.uid).val() === root.child('zeiterfassung/users').child($i).child('id').val()))" }
        }
      },

      "entries": {
        "$k": {
          ".write": "auth != null && (root.child('zeiterfassung/admins').child(auth.uid).val() === true || root.child('zeiterfassung/managers').child(auth.uid).val() === true || (root.child('zeiterfassung/allowed').child(auth.uid).val() === true && root.child('zeiterfassung/uidUser').child(auth.uid).val() != null && $k.beginsWith(root.child('zeiterfassung/uidUser').child(auth.uid).val() + '_') && $k.replace(root.child('zeiterfassung/uidUser').child(auth.uid).val() + '_', '').matches(/^[0-9]{4}_[0-9]{2}$/) && data.child('status').val() !== 'approved'))",
          "status": { ".validate": "root.child('zeiterfassung/admins').child(auth.uid).val() === true || root.child('zeiterfassung/managers').child(auth.uid).val() === true || newData.val() === 'draft' || newData.val() === 'submitted'" }
        }
      },

      "stamps": {
        "$uid": { ".write": "auth != null && (root.child('zeiterfassung/admins').child(auth.uid).val() === true || (root.child('zeiterfassung/allowed').child(auth.uid).val() === true && root.child('zeiterfassung/uidUser').child(auth.uid).val() === $uid))" }
      },

      "vacRequests": {
        "$id": { ".write": "auth != null && (root.child('zeiterfassung/admins').child(auth.uid).val() === true || root.child('zeiterfassung/managers').child(auth.uid).val() === true || (root.child('zeiterfassung/allowed').child(auth.uid).val() === true && root.child('zeiterfassung/uidUser').child(auth.uid).val() != null && (!data.exists() || data.child('userId').val() === root.child('zeiterfassung/uidUser').child(auth.uid).val()) && (!newData.exists() || newData.child('userId').val() === root.child('zeiterfassung/uidUser').child(auth.uid).val())))" }
      },

      "teamReports": { ".write": "auth != null && (root.child('zeiterfassung/admins').child(auth.uid).val() === true || root.child('zeiterfassung/managers').child(auth.uid).val() === true)" },
      "yearReports": { ".write": "auth != null && (root.child('zeiterfassung/admins').child(auth.uid).val() === true || root.child('zeiterfassung/managers').child(auth.uid).val() === true)" },

      "_fixes": {
        "lastAppBackup": {
          ".write": "auth != null && root.child('zeiterfassung/allowed').child(auth.uid).val() === true",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        }
      },

      "pwResetTokens": { ".write": "auth != null && root.child('zeiterfassung/allowed').child(auth.uid).val() === true" },

      "vertretungen":  { ".write": "auth != null && (root.child('zeiterfassung/admins').child(auth.uid).val() === true || root.child('zeiterfassung/gfAdmins').child(auth.uid).val() === true)" }
    },

    "crm": {
      ".read": "auth != null && root.child('zeiterfassung/allowed').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('zeiterfassung/allowed').child(auth.uid).val() === true"
    },
    "crm_history": {
      ".read": "auth != null && root.child('zeiterfassung/allowed').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('zeiterfassung/allowed').child(auth.uid).val() === true",
      ".indexOn": ["ts"]
    }
  }
}
